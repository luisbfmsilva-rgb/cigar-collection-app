# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard → Project Settings → API). These keys are public by design;
# the database is protected by row level security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Legal pages shown in Settings (publish them before submitting to the stores)
EXPO_PUBLIC_TERMS_URL=https://longash.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://longash.app/privacy
