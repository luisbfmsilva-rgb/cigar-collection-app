{
  "expo": {
    "name": "Long Ash",
    "slug": "long-ash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "longash",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17120E",
    "ios": {
      "bundleIdentifier": "app.longash",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "app.longash",
      "adaptiveIcon": {
        "backgroundColor": "#17120E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#17120E"
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-localization",
      "expo-audio",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Long Ash uses the camera to scan cigar box barcodes and take check-in photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Long Ash lets you attach photos of your cigars to check-ins.",
          "cameraPermission": "Long Ash uses the camera to take check-in photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Long Ash uses your location to suggest nearby cigar shops and lounges when you check in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
